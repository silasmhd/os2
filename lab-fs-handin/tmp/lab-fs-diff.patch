diff --git a/kernel/fs.c b/kernel/fs.c
index 40c9bd4..4a65a01 100644
--- a/kernel/fs.c
+++ b/kernel/fs.c
@@ -401,6 +401,35 @@ bmap(struct inode *ip, uint bn)
     return addr;
   }
 
+  bn -= NINDIRECT;
+  if(bn < NINDIRECT * NINDIRECT){
+    if(ip->addrs[NDIRECT+1] == 0){
+      ip->addrs[NDIRECT+1] = balloc(ip->dev);
+    }
+    bp = bread(ip->dev, ip->addrs[NDIRECT+1]);
+    uint *indirect_blocks = (uint*)bp->data;
+
+    uint i1 = bn / NINDIRECT;
+    uint i2 = bn % NINDIRECT;
+
+    if(indirect_blocks[i1] == 0){
+      indirect_blocks[i1] = balloc(ip->dev);
+      log_write(bp);
+    }
+    brelse(bp);
+
+    bp = bread(ip->dev, indirect_blocks[i1]);
+    uint *data_blocks = (uint*)bp->data;
+
+    if(data_blocks[i2] == 0){
+      data_blocks[i2] = balloc(ip->dev);
+      log_write(bp);
+    }
+    addr = data_blocks[i2];
+    brelse(bp);
+    return addr;
+  }
+
   panic("bmap: out of range");
 }
 
@@ -432,8 +461,31 @@ itrunc(struct inode *ip)
     ip->addrs[NDIRECT] = 0;
   }
 
+  if(ip->addrs[NDIRECT+1]){
+    bp = bread(ip->dev, ip->addrs[NDIRECT+1]);
+    uint *indirect_blocks = (uint*)bp->data;
+
+    for(int i = 0; i < NINDIRECT; i++){
+      if(indirect_blocks[i]){
+        struct buf *bp2 = bread(ip->dev, indirect_blocks[i]);
+        uint *data_blocks = (uint*)bp2->data;
+
+        for(int j = 0; j < NINDIRECT; j++){
+          if(data_blocks[j])
+            bfree(ip->dev, data_blocks[j]);
+        }
+        brelse(bp2);
+        bfree(ip->dev, indirect_blocks[i]);
+      }
+    }
+    brelse(bp);
+    bfree(ip->dev, ip->addrs[NDIRECT+1]);
+  }
+
   ip->size = 0;
   iupdate(ip);
+
+  
 }
 
