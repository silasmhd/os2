#!/usr/bin/env python3

import re
import subprocess
from gradelib import *

r = Runner(save("xv6.out"))

@test(0, "NettestsRunner")
def test_nettest():
    server = subprocess.Popen(["make", "server"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    r.run_qemu(shell_script([
        'nettests'
    ]), timeout=30)
    server.terminate()
    server.communicate()

@test(40, "Ping", parent=test_nettest)
def test_nettest_():
    r.match('^testing ping: OK$')

@test(20, "SingleProcess", parent=test_nettest)
def test_nettest_():
    r.match('^testing single-process pings: OK$')

@test(20, "MultiProcess", parent=test_nettest)
def test_nettest_fork_test():
    r.match('^testing multi-process pings: OK$')

@test(20, "DNS", parent=test_nettest)
def test_nettest_dns_test():
    r.match('^DNS OK$')

run_tests()
