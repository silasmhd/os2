+
 static void
-e1000_recv(void)
+e1000_recv()
 {
-  //
-  // Your code here.
-  //
-  // Check for packets that have arrived from the e1000
-  // Create and deliver an mbuf for each packet (using net_rx()).
-  //
+  acquire(&e1000_lock);
+
+  while (1) {
+    uint32_t idx = (regs[E1000_RDT] + 1) % RX_RING_SIZE;
+
+    if (!(rx_ring[idx].status & E1000_RXD_STAT_DD)) {
+      break;
+    }
+
+    struct mbuf *m = rx_mbufs[idx];
+    m->len = rx_ring[idx].length;
+
+    release(&e1000_lock);
+    net_rx(m);
+    acquire(&e1000_lock);
+
+
+    struct mbuf *new_m = mbufalloc(0);
+    if (!new_m) {
+      break;
+    }
+
+    rx_ring[idx].addr = (uint64_t)new_m->head;
+    rx_ring[idx].status = 0;
+    rx_mbufs[idx] = new_m;
+    regs[E1000_RDT] = idx;
+  }
+
+  release(&e1000_lock);
 }
 
