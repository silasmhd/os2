+    return -1;
+  }
+
+  //free old
+  if (tx_mbufs[tail]) {
+    mbuffree(tx_mbufs[tail]);
+    tx_mbufs[tail] = 0;
+  }
+
+  tx_ring[tail].addr = (uint64_t)m->head;
+  tx_ring[tail].length = m->len;
+  tx_ring[tail].cmd = E1000_TXD_CMD_EOP | E1000_TXD_CMD_RS;
+  tx_ring[tail].status = 0;
